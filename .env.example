# Client-side variables (Vite). Anything prefixed VITE_ is bundled into the
# public website/app. NEVER put a secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Cloudflare Turnstile site key for the error report form (public by design;
# the matching secret is TURNSTILE_SECRET_KEY in .dev.vars / Worker secrets).
# Unset: the report page says reporting isn't available yet.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Server-only variables used by scripts/ (e.g. batch profile generation).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
GOOGLE_CIVIC_API_KEY=your_google_civic_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
# Optional: send Gemini calls through Vertex AI in this Google Cloud project
# instead (higher quotas). Sign in once: gcloud auth application-default login
# VERTEX_PROJECT=your-project-id
# VERTEX_LOCATION=global
PERPLEXITY_API_KEY=your_perplexity_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
