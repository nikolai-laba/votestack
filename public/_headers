# Every page: standard browser safety instructions.
# - No other site may show VoteStack inside a frame (stops click tricks on
#   the address form). Both headers, for old and new browsers.
# - Browsers must not guess file types.
# - Other sites see only "votestack.org" as the referrer, never the full page.
# - Always use HTTPS (no subdomains included, so nothing else on the domain,
#   such as email services, is affected).
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Built files in /assets/ have a content hash in their names, so a file
# never changes once published: browsers may keep it for a year without
# checking back. Every other file (the pages) keeps Cloudflare's default
# of checking for a newer version on each visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
