{
  "name": "votestack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vite build && wrangler dev",
    "typecheck": "tsc -b && tsc -p worker && tsc -p scripts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "deploy": "npm run build && wrangler deploy",
    "data:fetch": "node scripts/fetch-boundaries.ts && node scripts/fetch-address-points.ts",
    "data:build": "node scripts/build-precincts.ts && node scripts/import-cook-clerk.ts && node scripts/import-chicago-boe.ts && node scripts/fetch-clerk-precincts.ts && node scripts/fetch-clerk-ballots.ts && node scripts/build-clerk-precincts.ts && node scripts/build-chicago-precincts.ts && node scripts/build-paper-order.ts",
    "lookup": "node scripts/lookup.ts",
    "data:audit": "node scripts/audit-sample-ballots.ts && node scripts/audit-chicago.ts",
    "data:load": "node --env-file=.env scripts/load-supabase.ts",
    "profiles:money": "node scripts/profiles/money.ts",
    "profiles:subjects": "node scripts/profiles/subjects.ts",
    "profiles:generate": "node --env-file-if-exists=.env scripts/profiles/generate.ts",
    "profiles:check": "node scripts/profiles/check.ts",
    "profiles:publish": "node --env-file-if-exists=.env scripts/profiles/publish.ts",
    "profiles:report": "node scripts/profiles/report.ts",
    "profiles:judges": "node scripts/profiles/judges.ts",
    "profiles:samples": "node --env-file-if-exists=.env scripts/profiles/samples.ts",
    "profiles:drafts": "node --env-file-if-exists=.env scripts/profiles/drafts.ts",
    "profiles:slates": "node scripts/profiles/slates.ts",
    "reports": "node --env-file=.env scripts/reports.ts",
    "data:incumbents": "node scripts/build-incumbents.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.16",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24"
  }
}
