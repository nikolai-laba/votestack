    "asOf": "2026-10-07",
    "items": [
      {
        "text": "Elgie R. Sims, Jr. has been the State Senator for the 17th District since 2018, after serving in the House. He chairs the Senate Appropriations Committee. He is an attorney. He previously worked as a budget analyst for the Illinois Senate President.",
        "cites": [1, 2, 3],
        "sentences": [
          {
            "text": "Elgie R. Sims, Jr. has been the State Senator for the 17th District since 2018, after serving in the House.",
            "cites": [1]
          },
          {
            "text": "He chairs the Senate Appropriations Committee.",
            "cites": [2]
          },
          { "text": "He is an attorney.", "cites": [1] },
          {
            "text": "He previously worked as a budget analyst for the Illinois Senate President.",
            "cites": [3]
          }
        ]
      },
      {
        "text": "He sponsored laws creating student loan servicing rights and a diversionary program for FOID card applicants. He led a measure to increase compensation for the wrongfully incarcerated and a bill to ensure free mail for people in prison. He sponsored a law creating a Medicaid expansion task force. He announced $26 million in state grants to address food deserts. He led efforts to pass the SAFE-T Act, a 2021 criminal justice and police accountability law.",
        "cites": [4, 5, 6, 3]
      }
    ]
  },
