  "overview": {
    "asOf": "2026-10-07",
    "items": [
      {
        "text": "Juliana Stratton is the Lieutenant Governor of Illinois, a role she has held since 2019. She previously served as a state representative for Illinois House District 5 from 2017 to 2018. Before elected office, she worked as a lawyer and mediator and directed the Cook County Justice Advisory Council and the University of Illinois Chicago's Center for Public Safety and Justice.",
        "cites": [1, 2],
        "sentences": [
          {
            "text": "Juliana Stratton is the Lieutenant Governor of Illinois, a role she has held since 2019.",
            "cites": [1]
          },
          {
            "text": "She previously served as a state representative for Illinois House District 5 from 2017 to 2018.",
            "cites": [1]
          },
          {
            "text": "Before elected office, she worked as a lawyer and mediator and directed the Cook County Justice Advisory Council and the University of Illinois Chicago's Center for Public Safety and Justice.",
            "cites": [2]
          }
        ]
      },
      {
        "text": "Her campaign lists as priorities a middle-class tax cut paid for by raising taxes on those making over $1 million a year, raising the federal minimum wage, and securing Medicare for All. She has proposed an immediate increase to a $25 per hour federal minimum wage. She supports abolishing Immigration and Customs Enforcement and the Protecting Sensitive Locations Act to keep immigration agents out of schools, churches, and hospitals. Stratton also supports abolishing the Senate filibuster, arguing the 60-vote threshold blocks progress on reproductive rights, gun safety laws, and voting rights. She supports reforming the Supreme Court, including setting term limits and deadlines for confirming appointments, and has said she would block judicial nominees she views as prioritizing loyalty to the president over the rule of law.",
        "cites": [3, 4, 5, 2],
        "sentences": [
          {
            "text": "Her campaign lists as priorities a middle-class tax cut paid for by raising taxes on those making over $1 million a year, raising the federal minimum wage, and securing Medicare for All.",
            "cites": [3]
          },
          {
            "text": "She has proposed an immediate increase to a $25 per hour federal minimum wage.",
            "cites": [4]
          },
          {
            "text": "She supports abolishing Immigration and Customs Enforcement and the Protecting Sensitive Locations Act to keep immigration agents out of schools, churches, and hospitals.",
            "cites": [5]
          },
          {
            "text": "Stratton also supports abolishing the Senate filibuster, arguing the 60-vote threshold blocks progress on reproductive rights, gun safety laws, and voting rights.",
            "cites": [5]
          },
          {
            "text": "She supports reforming the Supreme Court, including setting term limits and deadlines for confirming appointments, and has said she would block judicial nominees she views as prioritizing loyalty to the president over the rule of law.",
            "cites": [2]
          }
        ]
      },
      {
        "text": "As Lieutenant Governor, Stratton leads the Justice, Equity and Opportunity Initiative and chairs several state councils. Her campaign notes that in Illinois she helped eliminate the grocery tax, raise the state minimum wage, and relieve medical debt for thousands of families.",
        "cites": [6, 3],
        "sentences": [
          {
            "text": "As Lieutenant Governor, Stratton leads the Justice, Equity and Opportunity Initiative and chairs several state councils.",
            "cites": [6]
          },
          {
            "text": "Her campaign notes that in Illinois she helped eliminate the grocery tax, raise the state minimum wage, and relieve medical debt for thousands of families.",
            "cites": [3]
          }
        ]
      }
