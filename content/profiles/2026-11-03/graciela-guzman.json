  "overview": {
    "asOf": "2026-10-21",
    "items": [
      {
        "text": "Graciela Guzmán is the state senator for the 20th District, elected in 2024. She is an organizer for the Chicago Teachers Union and previously served as chief of staff for state Senator Cristina Pacione-Zayas. She sponsored a law requiring private equity-backed health care mergers to be reported to the state attorney general. She sponsored a law to require basic sanitation standards and access to menstrual products on construction sites. She sponsored a bill to allow minors to consent to receiving birth control. She sponsored legislation to create a state prescription drug affordability board. She opposed a Peoples Gas rate hike and pressed the company on high-risk pipes. She advocated for legislation to allow the public to sue federal immigration agents.",
        "cites": [1, 2, 3, 4, 5, 6, 7]
      }
    ]
  },
