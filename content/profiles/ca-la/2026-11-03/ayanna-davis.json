  "overview": {
    "asOf": "2026-10-14",
    "items": [
      {
        "text": "Ayanna Davis was elected to the Compton Unified School District Board of Trustees in 2022. She has worked as a classroom teacher and public school principal. Her campaign says Compton Unified reached the number-one graduation rate in L.A. County and top test scores for similar districts statewide.",
        "cites": [1, 2],
        "sentences": [
          {
            "text": "Ayanna Davis was elected to the Compton Unified School District Board of Trustees in 2022.",
            "cites": [1]
          },
          {
            "text": "She has worked as a classroom teacher and public school principal.",
            "cites": [2]
          },
          {
            "text": "Her campaign says Compton Unified reached the number-one graduation rate in L.A. County and top test scores for similar districts statewide.",
            "cites": [2]
          }
        ]
      },
      {
        "text": "She supports raising wages and expanding retirement benefits, and she wants to cut red tape to build affordable housing. She cites a district plan to build roughly 800 affordable units on unused land. She says she would strengthen Medi-Cal and expand the healthcare workforce. She says she will keep ICE out of schools, hospitals, churches and neighborhoods.",
        "cites": [3, 4, 2]
      }
    ]
  },
