    "items": [
      {
        "text": "Rick Chavez Zbur is the State Assembly Member for the 51st District and the Assembly Democratic Caucus Chair. He previously directed Equality California and was board president of California Environmental Voters. He authored the California Retail Theft Reduction Act, allowing multiple thefts to be charged as a felony. He backed a law expanding eligibility for the state's film and television tax credit.",
        "cites": [1, 2, 3],
        "sentences": [
          {
            "text": "Rick Chavez Zbur is the State Assembly Member for the 51st District and the Assembly Democratic Caucus Chair.",
            "cites": [1]
          },
          {
            "text": "He previously directed Equality California and was board president of California Environmental Voters.",
            "cites": [1]
          },
          {
            "text": "He authored the California Retail Theft Reduction Act, allowing multiple thefts to be charged as a felony.",
            "cites": [2]
          },
          {
            "text": "He backed a law expanding eligibility for the state's film and television tax credit.",
            "cites": [3]
          }
        ]
      },
      {
        "text": "He supported bills to maintain sterile syringe access and require large cities to plan for electric-vehicle charging. He also backed legislation protecting attorneys who help out-of-state clients seek reproductive and gender-affirming care. He opposed a coastal development exemption in Santa Monica. He led opposition to a bill allowing dense housing near transit, defending single-family zoning.",
        "cites": [3, 4, 5],
