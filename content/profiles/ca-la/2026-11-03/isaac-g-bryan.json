  "overview": {
    "asOf": "2026-10-14",
    "items": [
      {
        "text": "Isaac G. Bryan is the Democratic Assembly member for California's 55th District, representing Los Angeles, Culver City and parts of Inglewood. He was elected in May 2021 and previously founded the UCLA Black Policy Project. He chairs the Assembly Natural Resources Committee.",
        "cites": [1, 2],
        "sentences": [
          {
            "text": "Isaac G. Bryan is the Democratic Assembly member for California's 55th District, representing Los Angeles, Culver City and parts of Inglewood.",
            "cites": [1]
          },
          {
            "text": "He was elected in May 2021 and previously founded the UCLA Black Policy Project.",
            "cites": [1]
          },
          {
            "text": "He chairs the Assembly Natural Resources Committee.",
            "cites": [2]
          }
        ]
      },
      {
        "text": "His Assembly Bill 2716 requires the Inglewood Oil Field to close by 2030. Assembly Bill 1661 directs $5 million in cash aid to 1,000 nearby households with qualifying health impacts. He wrote Assembly Bill 246 to pause evictions for renters whose Social Security benefits are delayed without fault. He authored the Truth in Disclosure Act, which requires companies with over $100 million in annual gross receipts to disclose if they profited from chattel slavery.",
        "cites": [3, 4, 5],
        "sentences": [
