  "overview": {
    "asOf": "2026-10-14",
    "items": [
      {
        "text": "Elected in 2022, Lola Smallwood-Cuevas represents California's 28th State Senate District. She chairs the Senate Labor, Public Employment and Retirement Committee. She previously worked as a labor organizer, co-founding the Los Angeles Black Worker Center and directing a UCLA Labor Center project.",
        "cites": [1, 2, 3],
        "sentences": [
          {
            "text": "Elected in 2022, Lola Smallwood-Cuevas represents California's 28th State Senate District.",
            "cites": [1]
          },
          {
            "text": "She chairs the Senate Labor, Public Employment and Retirement Committee.",
            "cites": [2]
          },
          {
            "text": "She previously worked as a labor organizer, co-founding the Los Angeles Black Worker Center and directing a UCLA Labor Center project.",
            "cites": [3]
          }
        ]
      },
      {
        "text": "She led 2023 legislation protecting workers from retaliation for reporting wage theft and requiring advance notice for large retail store closures. She authored a 2026 law repealing the CalWORKs \"man in the house\" rule. She also proposed a 2026 bill to raise pay and training standards for security guards. She partnered with community leaders to establish the Historic South LA Black Cultural District. In 2026, she voted against a bill requiring more apartments near major transit stations.",
        "cites": [2, 4, 5, 6],
        "sentences": [
